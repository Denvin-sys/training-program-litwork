digits = input().replace(" ", "")

if digits == "":
    print([])
else:
    phone = {
        '2': "abc",
        '3': "def",
        '4': "ghi",
        '5': "jkl",
        '6': "mno",
        '7': "pqrs",
        '8': "tuv",
        '9': "wxyz"
    }

    result = [""]

    for d in digits:
        new = []

        for word in result:
            for letter in phone[d]:
                new.append(word + letter)

        result = new

    print(result)
